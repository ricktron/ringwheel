# Ringwheel frontend configuration for LOCAL DEVELOPMENT.
#
# Copy this file to .env.local (never commit it) and fill in the two values.
#
# IMPORTANT: every VITE_ value is compiled into the JavaScript that the browser
# downloads. It is not a secret. Do not build a publicly reachable copy of the
# site with a real token in here. For a hosted copy, leave the token empty and
# enter it on the Admin page instead (it is then kept in that browser only).
# See docs/SECURITY.md.

# The deployed Apps Script Web App URL. It ends with /exec.
VITE_SPIN_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Must match API_TOKEN in the Apps Script project's Script Properties.
VITE_RINGWHEEL_API_TOKEN=your-api-token-here
